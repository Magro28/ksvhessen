# Public hostnames. Create matching DNS A records pointing to the server IP.
SITE_DOMAIN=ksv.metascript.de
CMS_DOMAIN=cms.ksv.metascript.de
SITE_ORIGIN=https://ksv.metascript.de
CMS_ORIGIN=https://cms.ksv.metascript.de

# Database credentials
POSTGRES_DB=ksv
POSTGRES_USER=ksv
POSTGRES_PASSWORD=replace-with-a-strong-password

# Directus credentials
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=turgeon28@gmail.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# API-Football (serverseitiger Sync; niemals ins Frontend geben)
API_FOOTBALL_KEY=replace-with-api-football-key
API_FOOTBALL_LEAGUE_ID=86

# SMTP email delivery (example for Gmail with an app password)
EMAIL_VERIFY_SETUP=true
EMAIL_TRANSPORT=smtp
EMAIL_FROM=turgeon28@gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=turgeon28@gmail.com
EMAIL_SMTP_PASSWORD=replace-with-a-gmail-app-password
EMAIL_SMTP_SECURE=true
